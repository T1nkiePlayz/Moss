# Public connection settings for Moss's sign-in (Supabase Auth). Safe to commit:
# the publishable key is designed to be public, exactly like a site key in a web page.
# Secrets belong in .env.local, never in this file.
#
# Precedence: real environment variables > .env.local > .env
SUPABASE_URL=https://ddglnaswgvkqgkgrdspa.supabase.co
SUPABASE_ANON_KEY=sb_publishable__1aZJn7uHjKPqRfm2z5Ceg_x-3yqS3y

# Optional, in .env.local (never committed): pin who becomes owner on first verified sign-in.
# If unset, whoever enters the one-time setup token becomes owner.
#MOSS_OWNER_EMAILS=you@example.com
#
# Optional: your own CurseForge key for direct access (see docs/curseforge.md). Keep it in .env.local, never here.
#CURSEFORGE_API_KEY=
