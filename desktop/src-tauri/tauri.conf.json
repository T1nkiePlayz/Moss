{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moss",
  "version": "0.2.0",
  "identifier": "io.github.t1nkieplayz.moss",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "dmg"],
    "category": "Utility",
    "shortDescription": "Game servers that keep growing, quietly.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.icns"],
    "externalBin": ["binaries/moss"],
    "resources": { "resources/shipped.env": "shipped.env" },
    "macOS": { "minimumSystemVersion": "13.0", "signingIdentity": "-" },
    "linux": { "deb": { "depends": [] } }
  }
}
