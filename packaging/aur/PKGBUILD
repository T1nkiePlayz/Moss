# Maintainer: Moss contributors <https://github.com/T1nkiePlayz/Moss>
# Builds Moss from the tagged source tarball. The web UI is built with npm and embedded into the binary.
pkgname=moss
pkgver=0.2.0
pkgrel=1
pkgdesc="Fast, local-first game server controller (Minecraft Java first)"
arch=('x86_64' 'aarch64')
url="https://github.com/T1nkiePlayz/Moss"
license=('GPL-3.0-only')
depends=('gcc-libs' 'glibc')
makedepends=('cargo' 'nodejs' 'npm')
optdepends=('jre21-openjdk-headless: run Minecraft servers without downloading a managed Temurin')
backup=('etc/moss/moss.env')
install=moss.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP') # run `updpkgsums` after bumping pkgver

prepare() {
  cd "Moss-$pkgver"
  node scripts/sync-version.mjs "v$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "Moss-$pkgver"
  (cd web && npm ci && npm run build)
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "Moss-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd "Moss-$pkgver"
  install -Dm755 target/release/moss "$pkgdir/usr/bin/moss"
  install -Dm644 packaging/moss.service "$pkgdir/usr/lib/systemd/system/moss.service"
  sed -i 's#/usr/local/bin/moss#/usr/bin/moss#' "$pkgdir/usr/lib/systemd/system/moss.service"
  install -Dm640 .env "$pkgdir/etc/moss/moss.env"
  install -Dm644 packaging/moss.sysusers "$pkgdir/usr/lib/sysusers.d/moss.conf"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
