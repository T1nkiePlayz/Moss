# /etc/moss/moss.env  (chmod 640, owner root:moss)

# Supabase project used for sign-in (see docs/supabase.md). The anon/publishable key is public by design.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY

# Pin ownership: these emails become owner on first (verified) sign-in. Strongly recommended.
MOSS_OWNER_EMAILS=you@example.com

# Loopback by default. Put a TLS reverse proxy in front before binding anything else.
MOSS_BIND=127.0.0.1
MOSS_PORT=8420

# Only needed for projects that still sign tokens with the legacy HS256 JWT secret.
#SUPABASE_JWT_SECRET=
