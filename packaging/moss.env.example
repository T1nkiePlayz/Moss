# Optional settings for Moss. Copy to /etc/moss/moss.env (Linux, chmod 640) or
# ~/Library/Application Support/Moss/moss.env (macOS). Everything here has a working default.
# Sign-in is built into Moss; nothing here is needed for it.

# Pin who becomes owner on their first verified sign-in. If unset, whoever enters the one-time setup token
# (written to <data dir>/setup-token) becomes owner.
#MOSS_OWNER_EMAILS=you@example.com

# Loopback by default. Put a TLS reverse proxy in front before binding anything else.
MOSS_BIND=127.0.0.1
MOSS_PORT=8420

# Where Moss keeps servers, backups and its database.
#MOSS_DATA_DIR=/var/lib/moss

# Use your own sign-in project instead of the default (advanced).
#SUPABASE_URL=https://YOUR-PROJECT.supabase.co
#SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY

# CurseForge works without setup. Use your own key for direct access, or turn it off.
#CURSEFORGE_API_KEY=
#MOSS_CURSEFORGE_PROXY=off

# Look for new Moss releases (a minute after start, then every 6 hours) and offer them in the panel.
#MOSS_UPDATE_CHECK=false

# Hardening (optional)
#MOSS_REQUIRE_MFA=admins          # off | admins | all: require a two-factor session
#MOSS_TRUST_PROXY=true            # only behind a reverse proxy that sets X-Forwarded-For
#MOSS_ALLOW_PRIVATE_WEBHOOKS=false
