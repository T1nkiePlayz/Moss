# /etc/moss/moss.env  (chmod 640, owner root:moss)

# Supabase project used for sign-in (see docs/supabase.md). The anon/publishable key is public by design.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY

# Pin ownership: these emails become owner on first (verified) sign-in. Strongly recommended.
MOSS_OWNER_EMAILS=you@example.com

# Loopback by default. Put a TLS reverse proxy in front before binding anything else.
MOSS_BIND=127.0.0.1
MOSS_PORT=8420

# Only needed for projects that still sign tokens with the legacy HS256 JWT secret.
#SUPABASE_JWT_SECRET=

# CurseForge (optional). Either deploy the Supabase edge function and set its CURSEFORGE_API_KEY secret (see docs/curseforge.md),
# or give this instance your own key for direct access:
#CURSEFORGE_API_KEY=
#MOSS_CURSEFORGE_PROXY=off

# Security hardening (optional)
#MOSS_REQUIRE_MFA=admins          # off | admins | all: require an MFA (aal2) session
#MOSS_TRUST_PROXY=true            # only behind a reverse proxy that sets X-Forwarded-For
#MOSS_ALLOW_PRIVATE_WEBHOOKS=false
