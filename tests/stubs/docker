#!/usr/bin/env bash
# Test double for the `docker` CLI. It implements only the subcommands Moss uses and records every invocation
# (arguments separated by 0x1f, one invocation per line) to $STUB_LOG. "Containers" are plain host processes whose
# state lives under $STUB_STATE; the game command inside the container is replaced by $STUB_GAME_CMD ({PORT} is
# substituted with the published port), and /data in the entrypoint script is mapped to the bind-mounted directory.
# Nothing here proves behaviour of a real Docker or Podman: it only lets Moss's own logic be exercised.
set -u
STATE="${STUB_STATE:?STUB_STATE is required}"; LOG="${STUB_LOG:?STUB_LOG is required}"
mkdir -p "$STATE/c" "$STATE/images"
{ for a in "$@"; do printf '%s\x1f' "$a"; done; printf '\n'; } >> "$LOG"
cmd="${1:-}"; [ $# -gt 0 ] && shift
imgfile() { printf '%s/images/%s' "$STATE" "$(printf '%s' "$1" | tr '/:@' '___')"; }
nosuch() { echo "Error response from daemon: No such container: $1" >&2; exit 1; }
is_running() { local d="$STATE/c/$1"; [ -f "$d/pid" ] && [ ! -f "$d/exit" ] && kill -0 "$(cat "$d/pid")" 2>/dev/null; }
case "$cmd" in
  info) echo "27.0.0-stub|[name=seccomp,profile=builtin]" ;;
  image) # image inspect --format F IMAGE
    img="${*: -1}"; if [ -e "$(imgfile "$img")" ]; then echo "sha256:stub"; else echo "Error response from daemon: No such image: $img" >&2; exit 1; fi ;;
  pull)
    [ -n "${STUB_PULL_FAIL:-}" ] && { echo "Error: pull access denied" >&2; exit 1; }
    echo "Using default tag"; echo "abc123: Pulling fs layer"; echo "abc123: Downloading  10MB/20MB"; echo "Status: Downloaded newer image for $1"; touch "$(imgfile "$1")" ;;
  run)
    detach=0; rmflag=0; name=""; src=""; port=""; image=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --detach) detach=1; shift ;;
        --rm) rmflag=1; shift ;;
        --name) name="$2"; shift 2 ;;
        -v) src="${2%%:/data*}"; shift 2 ;;
        -p) port="${2%%:*}"; shift 2 ;;
        --label|-w|-e|--user|--tmpfs) shift 2 ;;
        --entrypoint) shift 2; image="$1"; shift; break ;;
        -*) shift ;;
        *) image="$1"; shift; break ;;
      esac
    done
    if [ "$detach" = 0 ]; then # installer-style foreground run: execute $STUB_INSTALLER_CMD in the mounted dir
      if [ -n "${STUB_INSTALLER_CMD:-}" ]; then ( cd "$src" && eval "$STUB_INSTALLER_CMD" ); exit $?; fi
      echo "stub installer ran: $*"; exit 0
    fi
    [ -n "${STUB_RUN_FAIL:-}" ] && { echo "docker: Error response from daemon: stub refused to run" >&2; exit 125; }
    d="$STATE/c/$name"
    [ -e "$d" ] && { echo "docker: Error response from daemon: Conflict. The container name \"$name\" is already in use" >&2; exit 125; }
    mkdir -p "$d"; echo "$image" > "$d/image"
    script="$2"; export HS="${script//\/data/$src}"; export GC="${STUB_GAME_CMD//\{PORT\}/$port}"; export D="$d"
    SETSID=; command -v setsid >/dev/null 2>&1 && SETSID=setsid # macOS has no setsid binary
    $SETSID bash -c 'sh -c "echo \$\$ > \"\$D/pid\"; $HS" moss-run $GC; echo $? > "$D/exit"' </dev/null >/dev/null 2>&1 &
    for _ in $(seq 1 100); do [ -s "$d/pid" ] && break; sleep 0.03; done
    echo "stubcontainer-$name" ;;
  inspect)
    name="${*: -1}"; d="$STATE/c/$name"; [ -d "$d" ] || nosuch "$name"
    oom=false; [ -f "$d/oom" ] && oom=true
    if is_running "$name"; then echo "running|true|0|$oom|$(cat "$d/pid")"
    else echo "exited|false|$(cat "$d/exit" 2>/dev/null || echo 137)|$oom|0"; fi ;;
  ps)
    for d in "$STATE"/c/*; do [ -d "$d" ] || continue; n="$(basename "$d")"; is_running "$n" && echo "$n"; done; exit 0 ;;
  stop)
    t=10; [ "${1:-}" = "--time" ] && { t="$2"; shift 2; }
    name="$1"; d="$STATE/c/$name"; [ -d "$d" ] || nosuch "$name"
    if is_running "$name"; then
      kill -TERM "$(cat "$d/pid")" 2>/dev/null
      for _ in $(seq 1 $((t * 20))); do is_running "$name" || break; sleep 0.05; done
      is_running "$name" && kill -KILL "$(cat "$d/pid")" 2>/dev/null
      for _ in $(seq 1 60); do [ -f "$d/exit" ] && break; sleep 0.05; done
    fi ;;
  kill)
    name="$1"; d="$STATE/c/$name"; [ -d "$d" ] || nosuch "$name"
    is_running "$name" || { echo "Error response from daemon: cannot kill container: $name: container is not running" >&2; exit 1; }
    kill -KILL "$(cat "$d/pid")" 2>/dev/null
    for _ in $(seq 1 60); do [ -f "$d/exit" ] && break; sleep 0.05; done ;;
  rm)
    [ "${1:-}" = "--force" ] && shift
    name="$1"; d="$STATE/c/$name"; [ -d "$d" ] || nosuch "$name"
    is_running "$name" && kill -KILL "$(cat "$d/pid")" 2>/dev/null
    rm -rf "$d" ;;
  logs)
    name="${*: -1}"; [ -d "$STATE/c/$name" ] || nosuch "$name"; echo "stub container log for $name" ;;
  stats)
    for a in "$@"; do case "$a" in -*|"{{"*) ;; *) n="$a"; is_running "$n" && echo "$n|7.50%|256MiB / 1GiB" ;; esac; done; exit 0 ;;
  *) echo "stub docker: unsupported subcommand: $cmd" >&2; exit 2 ;;
esac
